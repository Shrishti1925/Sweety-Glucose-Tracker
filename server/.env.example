# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_glucose_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Or use a full connection string (e.g. Neon, Supabase, Render, local URL)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sweety_glucose_db

# JWT (JSON Web Token) Secret & Expiration
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=7d
